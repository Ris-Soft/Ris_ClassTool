{
  "name": "lesson-plugin",
  "version": "1.0.0",
  "description": "基于Electron的插件化课堂工具框架",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:renderer": "cd src/renderer && npm start",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "cd src/renderer && npm run build",
    "postinstall": "cd src/renderer && npm install"
  },
  "keywords": [
    "electron",
    "classroom",
    "tools",
    "plugins"
  ],
  "author": "PYLXU",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^37.3.1",
    "electron-builder": "^24.6.4",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-store": "^8.1.0",
    "fs-extra": "^11.1.1",
    "semver": "^7.5.4"
  },
  "build": {
    "appId": "com.ris.lessonplugin",
    "productName": "LessonPlugin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/build/**/*",
      "node_modules/**/*"
    ]
  }
}
